{
  "name": "@workspace-about/automations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibestudio": {
    "title": "Automations",
    "icon": "./assets/icon.svg",
    "description": "Supervise schedules, runs, conversations, results, and errors",
    "hiddenInLauncher": false,
    "autoArchiveWhenEmpty": true,
    "stateArgs": {
      "type": "object",
      "properties": {
        "missionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "provides": [],
      "serviceRequests": [
        {
          "protocol": "vibestudio.missions.v1",
          "availability": "required"
        }
      ],
      "requests": [
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": "context"
          },
          "tier": "critical",
          "evidence": "bounded-dynamic"
        },
        {
          "capability": "context.materialize",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "subagents.create",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace-service:channel",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace-service:missions",
          "resource": {
            "kind": "exact",
            "key": "do:workers/missions:MissionsDO:workspace-missions"
          },
          "tier": "gated",
          "evidence": "exact"
        },
        {
          "capability": "workspace-service:models",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        }
      ]
    }
  },
  "dependencies": {
    "@vibestudio/automation": "workspace:*",
    "@workspace/runtime": "workspace:*",
    "@workspace/about-shared": "workspace:*",
    "@workspace/agentic-chat": "workspace:*",
    "@vibestudio/shared": "workspace:*",
    "@radix-ui/themes": "3.3.0",
    "@radix-ui/react-icons": "1.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
