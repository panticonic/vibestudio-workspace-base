{
  "name": "@workspace-extensions/mobile-debug",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibestudio": {
    "displayName": "Mobile Debug",
    "icon": "./assets/icon.svg",
    "entry": "index.ts",
    "sourcemap": true,
    "extension": {
      "activationEvents": [
        "onInvoke"
      ],
      "streamingMethods": [
        "logcat",
        "logsIos",
        "shell"
      ],
      "methodAuthority": {
        "doctor": {
          "effect": {
            "kind": "open"
          }
        },
        "listDevices": {
          "effect": {
            "kind": "open"
          }
        },
        "listIosSimulators": {
          "effect": {
            "kind": "open"
          }
        },
        "buildAndroid": {
          "effect": {
            "kind": "open"
          }
        },
        "installAndroid": {
          "effect": {
            "kind": "open"
          }
        },
        "installIos": {
          "effect": {
            "kind": "open"
          }
        },
        "launchAndroid": {
          "effect": {
            "kind": "open"
          }
        },
        "launchIos": {
          "effect": {
            "kind": "open"
          }
        },
        "clearAndroidApp": {
          "effect": {
            "kind": "open"
          }
        },
        "adbReverse": {
          "effect": {
            "kind": "open"
          }
        },
        "screenshot": {
          "effect": {
            "kind": "open"
          }
        },
        "screenshotIos": {
          "effect": {
            "kind": "open"
          }
        },
        "verify": {
          "effect": {
            "kind": "open"
          }
        },
        "verifyWorkspaceReady": {
          "effect": {
            "kind": "open"
          }
        },
        "logcat": {
          "effect": {
            "kind": "open"
          }
        },
        "logsIos": {
          "effect": {
            "kind": "open"
          }
        },
        "shell": {
          "effect": {
            "kind": "open"
          }
        }
      }
    },
    "authority": {
      "provides": [],
      "requests": [
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "critical",
          "evidence": "intentional-broad"
        },
        {
          "capability": "native.mobile.execute",
          "resource": {
            "kind": "exact",
            "key": "native.mobile"
          },
          "tier": "gated",
          "evidence": "exact"
        }
      ]
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@vibestudio/extension": "workspace:*"
  }
}
