{
  "name": "@workspace-skills/onboarding",
  "version": "0.1.0",
  "type": "module",
  "vibestudio": {
    "authority": {
      "provides": [],
      "requests": [],
      "serviceRequests": [
        {
          "protocol": "vibestudio.models.v1",
          "availability": "required"
        }
      ]
    }
  },
  "exports": {
    ".": "./index.ts",
    "./catalog": "./catalog.ts",
    "./execution": "./execution.ts",
    "./routing": "./routing.ts",
    "./snapshot": "./snapshot.ts",
    "./status": "./status.ts",
    "./templates": "./templates.ts"
  },
  "dependencies": {
    "@vibestudio/browser-data": "workspace:*",
    "@vibestudio/service-schemas": "workspace:*",
    "@vibestudio/shared": "workspace:*",
    "@workspace/model-catalog": "workspace:*",
    "@workspace/runtime": "workspace:*",
    "@workspace/template-registry": "workspace:*",
    "@radix-ui/react-icons": "1.3.2"
  },
  "//peerDependencies": "This skill's components are rendered inside a panel's realm, which already holds React and the Radix theme. Declared as peers, they resolve to those live instances instead of being bundled again -- a second React means the host's hooks and the guest's are different hooks, and a second Theme means the guest renders outside the host's context.",
  "peerDependencies": {
    "react": "19.2.4",
    "@radix-ui/themes": "3.3.0"
  }
}
