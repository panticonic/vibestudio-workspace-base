{
  "name": "@workspace-workers/quickfire-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "vibestudio": {
    "icon": "./assets/icon.svg",
    "entry": "index.ts",
    "durable": {
      "classes": [
        {
          "className": "QuickfireAgentWorker"
        }
      ]
    },
    "agent": {
      "displayName": "Quickfire",
      "description": "Quick inspector attached to one panel"
    },
    "exposeModules": [
      "@workspace/runtime",
      "@workspace/pubsub",
      "zod"
    ],
    "authority": {
      "provides": [],
      "requests": [
        {
          "capability": "panel.inspect",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "bounded-dynamic"
        },
        {
          "capability": "context.boundary",
          "resource": {
            "kind": "prefix",
            "prefix": "context"
          },
          "tier": "critical",
          "evidence": "bounded-dynamic"
        },
        {
          "capability": "workspace-service:channel",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        },
        {
          "capability": "workspace-service:models",
          "resource": {
            "kind": "prefix",
            "prefix": ""
          },
          "tier": "gated",
          "evidence": "intentional-broad"
        }
      ]
    }
  },
  "dependencies": {
    "@workspace/agentic-do": "workspace:*",
    "@workspace/harness": "workspace:*",
    "@workspace/pi-core": "workspace:*",
    "@workspace/pubsub": "workspace:*",
    "@workspace/runtime": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "vitest": "3.2.7"
  }
}
